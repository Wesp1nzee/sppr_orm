# Application
APP_NAME=СППР ОРМ
APP_ENV=development
DEBUG=false

# Security
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_GENERATE_WITH_SECRETS_TOKEN_URLSAFE

# CORS (конкретные origins, не "*")
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Database (PostgreSQL, async)
DATABASE_URL=postgresql+asyncpg://app:app_secret@localhost:5432/sppr_orm
DB_ECHO=false
# Для интеграционных тестов
# TEST_DATABASE_URL=postgresql+asyncpg://app:app_secret@localhost:5432/sppr_orm_test

# Redis (сессии, кэш)
REDIS_URL=redis://localhost:6379/0

# Sessions
# 30 минут скользящего TTL; жёсткий лимит сессии — 12 часов
SESSION_TTL_SECONDS=1800
SESSION_HARD_EXPIRE_SECONDS=43200

# Cookies
# В production за HTTPS выставить true
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.example.ru

# Хранилище загруженных материалов дела (PDF/DOCX)
CASE_MATERIALS_STORAGE_DIR=./case_materials_storage
